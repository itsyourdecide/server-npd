msgstr ""
"Project-Id-Version: NPD Portal 0.1\n"
"Language: uk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && "
"n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Overview"
msgstr "Огляд"

msgid "Requests"
msgstr "Заявки"

msgid "Notifications"
msgstr "Сповіщення"

msgid "Administration"
msgstr "Адміністрування"

msgid "Toggle navigation"
msgstr "Відкрити або закрити навігацію"

msgid "Need cluster access?"
msgstr "Потрібен доступ до кластера?"

msgid "Create a request and track every approval step here."
msgstr "Створіть заявку та відстежуйте тут кожен етап погодження."

msgid "Create request"
msgstr "Створити заявку"

msgid "Change language"
msgstr "Змінити мову"

msgid "Portal account"
msgstr "Обліковий запис порталу"

msgid "Sign out"
msgstr "Вийти"

msgid "NPD compute cluster"
msgstr "Обчислювальний кластер NPD"

msgid "Portal"
msgstr "Портал"

msgid "NPD compute cluster · Internal development portal"
msgstr "Обчислювальний кластер NPD · Внутрішній портал розробки"

msgid "Access to the NPD compute cluster"
msgstr "Доступ до обчислювального кластера NPD"

msgid "Sign in"
msgstr "Увійти"

msgid "Use your portal account to manage access requests and follow their progress."
msgstr "Використовуйте обліковий запис порталу, щоб керувати заявками на доступ і стежити за їх виконанням."

msgid "Continue with %(oidc_provider_name)s"
msgstr "Продовжити через %(oidc_provider_name)s"

msgid "or use your portal account"
msgstr "або скористайтеся обліковим записом порталу"

msgid "Username or password is incorrect."
msgstr "Неправильне ім’я користувача або пароль."

msgid "NPD compute cluster · Authorized users only"
msgstr "Обчислювальний кластер NPD · Лише для авторизованих користувачів"

msgid "Username"
msgstr "Ім’я користувача"

msgid "Password"
msgstr "Пароль"

msgid "New request"
msgstr "Нова заявка"

msgid "Welcome to the NPD cluster portal"
msgstr "Ласкаво просимо до порталу кластера NPD"

msgid "Request cluster access or resources here, then follow the request through review and execution."
msgstr "Запитуйте тут доступ до кластера або ресурси, а потім відстежуйте перевірку та виконання заявки."

msgid "Accessible projects"
msgstr "Доступні проєкти"

msgid "Projects where you can submit requests"
msgstr "Проєкти, у яких ви можете подавати заявки"

msgid "My requests"
msgstr "Мої заявки"

msgid "All requests you created"
msgstr "Усі створені вами заявки"

msgid "Open requests"
msgstr "Відкриті заявки"

msgid "Drafts and requests still in progress"
msgstr "Чернетки та заявки, робота над якими ще триває"

msgid "Unread notifications"
msgstr "Непрочитані сповіщення"

msgid "New updates that need your attention"
msgstr "Нові оновлення, які потребують вашої уваги"

msgid "How it works"
msgstr "Як це працює"

msgid "Create a request"
msgstr "Створіть заявку"

msgid "Choose a project and describe the access or resource you need. The request starts as a draft."
msgstr "Оберіть проєкт і опишіть потрібний доступ або ресурс. Спочатку заявку буде збережено як чернетку."

msgid "Submit it for review"
msgstr "Надішліть її на розгляд"

msgid "When the draft is ready, submit it. A reviewer can approve it or explain why it was rejected."
msgstr "Коли чернетка готова, надішліть її. Рецензент може схвалити заявку або пояснити причину відхилення."

msgid "Track execution"
msgstr "Стежте за виконанням"

msgid "Approved requests are completed by an operator. Every state change remains visible in the request history."
msgstr "Схвалені заявки виконує оператор. Кожна зміна стану залишається в історії заявки."

msgid "Quick actions"
msgstr "Швидкі дії"

msgid "Start a cluster access or resource request"
msgstr "Створити заявку на доступ до кластера або ресурси"

msgid "View requests"
msgstr "Переглянути заявки"

msgid "Check status, history, and available actions"
msgstr "Перевірити стан, історію та доступні дії"

msgid "new"
msgstr "нових"

msgid "Read updates about your requests"
msgstr "Переглянути оновлення ваших заявок"

msgid "Cluster identity"
msgstr "Обліковий запис у кластері"

msgid "Use this login for cluster services after access is provisioned."
msgstr "Використовуйте цей логін для сервісів кластера після надання доступу."

msgid "Provisioned"
msgstr "Створено"

msgid "Cluster identity has not been provisioned."
msgstr "Обліковий запис у кластері ще не створено."

msgid "Your portal account works, but no Linux account has been created on the cluster yet. Submit a cluster access request to start that process."
msgstr "Ваш обліковий запис порталу вже працює, але обліковий запис Linux у кластері ще не створено. Подайте заявку на доступ до кластера, щоб розпочати цей процес."

msgid "Request cluster access"
msgstr "Запросити доступ до кластера"

msgid "Signed in as %(username)s."
msgstr "Ви увійшли як %(username)s."

msgid "Requests turn your needs into tracked work"
msgstr "Заявки перетворюють ваші потреби на контрольовані завдання"

msgid "Save a draft while you prepare it, submit it for review, and return here to see decisions and execution results."
msgstr "Зберігайте чернетку під час підготовки, надішліть її на розгляд і поверніться сюди, щоб побачити рішення та результат виконання."

msgid "Requests you created, newest first"
msgstr "Створені вами заявки, спочатку найновіші"

msgid "Request"
msgstr "Заявка"

msgid "Project"
msgstr "Проєкт"

msgid "Status"
msgstr "Стан"

msgid "Updated"
msgstr "Оновлено"

msgid "Open"
msgstr "Відкрити"

msgid "No requests yet."
msgstr "Заявок ще немає."

msgid "Create a request for cluster access or resources."
msgstr "Створіть заявку на доступ до кластера або ресурси."

msgid "Review queue"
msgstr "Черга на розгляд"

msgid "Submitted requests waiting for a reviewer decision"
msgstr "Подані заявки, які очікують рішення рецензента"

msgid "Author"
msgstr "Автор"

msgid "Review"
msgstr "Розглянути"

msgid "Operator queue"
msgstr "Черга оператора"

msgid "Approved work waiting for manual execution"
msgstr "Схвалені завдання, що очікують ручного виконання"

msgid "Start with a draft"
msgstr "Почніть із чернетки"

msgid "Saving this form does not send anything for approval yet. You can review the draft first, then submit it from the request page."
msgstr "Збереження цієї форми ще нічого не надсилає на погодження. Спочатку перевірте чернетку, а потім надішліть її зі сторінки заявки."

msgid "Request details"
msgstr "Деталі заявки"

msgid "Fields marked with an asterisk are required"
msgstr "Поля, позначені зірочкою, обов’язкові"

msgid "Cancel"
msgstr "Скасувати"

msgid "Save draft"
msgstr "Зберегти чернетку"

msgid "What happens next?"
msgstr "Що буде далі?"

msgid "This is a draft. Check the details, then submit it for review when it is ready."
msgstr "Це чернетка. Перевірте деталі та надішліть її на розгляд, коли все буде готово."

msgid "This request is in the review stage. The reviewer action is available on the right."
msgstr "Заявка перебуває на етапі розгляду. Дія для рецензента доступна праворуч."

msgid "This request is ready for operator work. Record each execution step using the action on the right."
msgstr "Заявка готова до роботи оператора. Фіксуйте етапи виконання за допомогою дії праворуч."

msgid "There is no action required from you now. The complete record remains available below."
msgstr "Зараз від вас не потрібно жодних дій. Повна історія залишається доступною нижче."

msgid "Type"
msgstr "Тип"

msgid "Created"
msgstr "Створено"

msgid "Description"
msgstr "Опис"

msgid "No description."
msgstr "Опис відсутній."

msgid "History"
msgstr "Історія"

msgid "A permanent timeline of who changed the request and when"
msgstr "Незмінна хронологія того, хто й коли змінював заявку"

msgid "%(date)s by %(username)s"
msgstr "%(date)s · %(username)s"

msgid "No history entries."
msgstr "Записів в історії ще немає."

msgid "Submit for review"
msgstr "Надіслати на розгляд"

msgid "After submission, the draft becomes read-only and enters the reviewer queue."
msgstr "Після надсилання чернетка стане доступною лише для читання та потрапить до черги рецензента."

msgid "Claim this request before recording a decision."
msgstr "Візьміть цю заявку на розгляд, перш ніж фіксувати рішення."

msgid "Start review"
msgstr "Почати розгляд"

msgid "Decision"
msgstr "Рішення"

msgid "Approve or reject the request and leave a permanent explanation."
msgstr "Схваліть або відхиліть заявку та залиште пояснення, яке буде збережено в історії."

msgid "Record decision"
msgstr "Зберегти рішення"

msgid "Execution"
msgstr "Виконання"

msgid "Mark the approved request as being handled by an operator."
msgstr "Позначте, що оператор розпочав роботу зі схваленою заявкою."

msgid "Begin manual execution"
msgstr "Почати ручне виконання"

msgid "Execution result"
msgstr "Результат виконання"

msgid "Record whether the work completed successfully and summarize the result."
msgstr "Вкажіть, чи виконано роботу успішно, та коротко опишіть результат."

msgid "Record result"
msgstr "Зберегти результат"

msgid "No action required"
msgstr "Дій не потрібно"

msgid "This request has no available actions for your account in its current state."
msgstr "У поточному стані ця заявка не має дій, доступних вашому обліковому запису."

msgid "Request updates appear here"
msgstr "Тут з’являються оновлення заявок"

msgid "Open a notification to view the related request. Mark it as read when you no longer need the reminder."
msgstr "Відкрийте сповіщення, щоб переглянути пов’язану заявку. Позначте його прочитаним, коли нагадування більше не потрібне."

msgid "New"
msgstr "Нове"

msgid "Open request"
msgstr "Відкрити заявку"

msgid "Mark as read"
msgstr "Позначити прочитаним"

msgid "No notifications."
msgstr "Сповіщень немає."

msgid "Updates about your requests will appear here."
msgstr "Тут з’являтимуться оновлення ваших заявок."

msgid "Select the project that will own the requested access or resources."
msgstr "Оберіть проєкт, до якого належатиме запитаний доступ або ресурси."

msgid "Cluster access"
msgstr "Доступ до кластера"

msgid "Resource"
msgstr "Ресурс"

msgid "Request type"
msgstr "Тип заявки"

msgid "Choose cluster access for a new account, or resource for an infrastructure request."
msgstr "Оберіть доступ до кластера для нового облікового запису або ресурс для інфраструктурного запиту."

msgid "Title"
msgstr "Назва"

msgid "Use a short, specific name so reviewers can understand the request at a glance."
msgstr "Вкажіть коротку й конкретну назву, щоб рецензент одразу зрозумів суть заявки."

msgid "Explain what you need, why you need it, and any relevant limits or deadlines."
msgstr "Опишіть, що саме і навіщо вам потрібно, а також важливі обмеження чи строки."

msgid "Approved"
msgstr "Схвалено"

msgid "Rejected"
msgstr "Відхилено"

msgid "Comment"
msgstr "Коментар"

msgid "Record the reason for the decision. This becomes part of the permanent history."
msgstr "Зафіксуйте причину рішення. Коментар стане частиною незмінної історії."

msgid "Completed successfully"
msgstr "Виконано успішно"

msgid "Failed"
msgstr "Помилка"

msgid "Outcome"
msgstr "Результат"

msgid "Summarize what was done or why execution failed."
msgstr "Коротко опишіть виконану роботу або причину помилки."

msgid "Draft"
msgstr "Чернетка"

msgid "Submitted"
msgstr "Подано"

msgid "Under review"
msgstr "На розгляді"

msgid "Executing"
msgstr "Виконується"

msgid "Active"
msgstr "Активна"

msgid "Request status: %(state)s"
msgstr "Стан заявки: %(state)s"

msgid "Your request \"%(title)s\" changed to %(state)s."
msgstr "Стан вашої заявки «%(title)s» змінено на «%(state)s»."
