POSTGRES_DB=npd_portal
POSTGRES_USER=npd_portal
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PORTAL_BUILD_VERSION=development
PORTAL_BUILD_COMMIT=unknown

# Required by config.settings.production
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=portal.example.edu
# Google OpenID Connect. Create a Web application OAuth client in Google Cloud.
OIDC_OP_ISSUER=https://accounts.google.com
OIDC_OP_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OIDC_OP_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OIDC_OP_USER_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
OIDC_OP_JWKS_ENDPOINT=https://www.googleapis.com/oauth2/v3/certs
OIDC_RP_CLIENT_ID=replace-me
OIDC_RP_CLIENT_SECRET=replace-me
OIDC_RP_SIGN_ALGO=RS256
OIDC_TIMEOUT=10
