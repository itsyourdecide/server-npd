server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    root /srv/pxe/http;
    index index.html;

    location /alma-cache/ {
        resolver 10.10.80.1 valid=300s ipv6=off;
        set $alma_mirror repo.almalinux.org;
        rewrite ^/alma-cache/(.*)$ /$1 break;
        proxy_pass http://$alma_mirror;
        proxy_http_version 1.1;
        proxy_set_header Host $alma_mirror;
        proxy_set_header Connection "";

        proxy_cache alma_cache;
        proxy_cache_valid 200 302 30d;
        proxy_cache_valid 404 10m;
        proxy_cache_revalidate on;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 20m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_ignore_headers Set-Cookie;
        add_header X-NPD-Cache $upstream_cache_status always;
    }

    location / {
        autoindex on;
        try_files $uri $uri/ =404;
    }
}
