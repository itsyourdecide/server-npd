[Unit]
Description=Public SSH forward to NPD bastion through WireGuard
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:10000,bind=0.0.0.0,fork,reuseaddr TCP:10.255.80.2:10022
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
