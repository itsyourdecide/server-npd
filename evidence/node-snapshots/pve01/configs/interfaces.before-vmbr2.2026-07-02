auto lo
iface lo inet loopback

iface nic0 inet manual

auto vmbr0
iface vmbr0 inet static
	address 192.168.31.50/24
	gateway 192.168.31.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0

iface nic1 inet manual

auto vmbr1
iface vmbr1 inet manual
	bridge-ports none
	bridge-stp off
	bridge-fd 0


source /etc/network/interfaces.d/*
